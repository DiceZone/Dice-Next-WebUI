{
  "name": "dice-next-web",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "tsc -p tsconfig.app.json && vite build",
    "lint": "tsc -p tsconfig.app.json --noEmit --emitDeclarationOnly false --composite false",
    "pretest": "node scripts/check-node-version.mjs",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:mcp-browser": "playwright test --config playwright.mcp.config.mjs",
    "test:v2-browser": "playwright test --config playwright.v2.config.mjs",
    "typecheck": "tsc -p tsconfig.app.json",
    "quality": "biome check .",
    "format": "biome format --write .",
    "test:lists": "tsc -p tsconfig.test.json && node --test tests/server-list-page.test.mjs",
    "test:images": "node --test tests/image-resources.test.mjs",
    "test:groups": "tsc -p tsconfig.test.json && node --test tests/group-management.test.mjs tests/ai-settings.test.mjs",
    "test:reply-regex": "tsc -p tsconfig.test.json && node --test tests/reply-regex.test.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "dev:preview": "node tests/ui-preview.mjs --workspace",
    "test:tour-preview": "node tests/tour-preview.mjs",
    "test:notice-browser": "playwright test --config playwright.notice.config.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "6.0.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "^8.17.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "4.4.0",
    "i18next": "^23.11.5",
    "lucide-react": "^0.400.0",
    "motion": "14.6.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.0",
    "react-i18next": "^14.1.2",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.7"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "^0.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "0.25.12",
    "jsdom": "30.1.3",
    "sharp": "^0.35.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.0",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
